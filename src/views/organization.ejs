<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= organizationDetails.name %></h2> 
    <div class="organization-header">
        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.org_name %> logo">
        <% if (user && user.role_name === 'admin') { %>
            <a class="action-button" href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a>
        <% } %>
    </div>

    <p>Description: <%= organizationDetails.description %></p>

    <h3>Service Projects</h3>
    <ul>
        <% projects.forEach(project => { %>
            <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>