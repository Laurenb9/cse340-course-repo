<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
                <p>
                    Partner Organization:
                    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                </p>
                <p><%= project.location %></p>
                <p><%= project.date.toISOString().split('T')[0] %></p>
                <p><%= project.description %></p>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>