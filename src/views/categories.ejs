<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Project Categories</h2>

    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a class="category-link" href="/category/<%= category.category_id %>">
                    <h3>
                        <strong><%= category.category_name %></strong>
                    </h3>
                </a>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>